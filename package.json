{
  "name": "scoundrel",
  "private": true,
  "version": "0.0.0",
  "description": "Scoundrel: a single-player dungeon card game (Zach Gage & Kurt Bieg rules) for the web.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.game.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "android:build": "vite build && node scripts/android.mjs build",
    "android:install": "node scripts/android.mjs install",
    "android:run": "vite build && node scripts/android.mjs run",
    "android:log": "node scripts/android.mjs log"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
