{
  // Purity gate: src/game and src/tutorial must compile with NO DOM lib and no Node types.
  // If anything in the rules engine or the tutorial step machine touches window/document/canvas/audio, this fails.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/game", "src/tutorial"]
}
